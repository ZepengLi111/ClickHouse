--- string partition: bounds pin the manifest to its own partition ---
partition=eu summaries=1 contains_null=false contains_nan=NULL bounds=(\'eu\',\'eu\') bounds_are_own_partition=yes
partition=us summaries=1 contains_null=false contains_nan=NULL bounds=(\'us\',\'us\') bounds_are_own_partition=yes
--- Int32 partition: bounds decode to the partition value ---
partition=10 bounds=(10,10) bounds_are_own_partition=yes
partition=11 bounds=(11,11) bounds_are_own_partition=yes
--- unpartitioned: no field summaries ---
1	0
--- after DELETE: carried-forward and position-delete entries keep bounds ---
content=0 bounds=(\'eu\',\'eu\')
content=0 bounds=(\'us\',\'us\')
content=1 bounds=(\'eu\',\'eu\')
--- data reads back unchanged ---
eu	1
us	2
us	3
